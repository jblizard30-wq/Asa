# PostgreSQL connection string used by Prisma
# Example for a local Postgres instance:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/asa?schema=public"
DATABASE_URL=""

# NextAuth
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Per-deployment branding (see src/lib/site.ts). All optional — blank/unset
# renders a neutral, org-agnostic default rather than any specific customer's
# branding. Every real deployment sets these explicitly.
ORG_NAME=""
BRAND_COLOR=""
LOGO_URL=""

# Optional: outbound email for notifications (e.g. Resend, SMTP relay).
# Leave blank to disable email sending — in-app notifications still work.
EMAIL_FROM=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""

# Shared secret this deployment and the vendor's HQ app both hold, used to
# sign/verify HQ's one-click "log in as admin" links (see
# src/lib/supportLogin.ts). Generate one per deployment with:
# openssl rand -base64 32 — never share the same value across customers.
HQ_SUPPORT_SECRET=""

# Shared secret checked against the Authorization header on the automations cron endpoint
# (/api/cron/automations), which drives due-date-based workflow automation rules.
# Generate one with: openssl rand -base64 32
CRON_SECRET=""

# Vercel Blob store token for task file attachments.
# Create a Blob store in the Vercel dashboard (Storage tab) and copy its token,
# or run `vercel env pull` in a project already linked to one.
BLOB_READ_WRITE_TOKEN=""

# Optional: Google/Outlook calendar connect buttons under Settings > Integrations show
# "Not configured" until these are set. Connecting a calendar does not sync it yet —
# see src/lib/integrations/*.ts.
GOOGLE_CALENDAR_CLIENT_ID=""
GOOGLE_CALENDAR_CLIENT_SECRET=""
OUTLOOK_CALENDAR_CLIENT_ID=""
OUTLOOK_CALENDAR_CLIENT_SECRET=""
