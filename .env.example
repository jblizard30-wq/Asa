# PostgreSQL connection string used by Prisma
# Example for a local Postgres instance:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/church_tasks?schema=public"
DATABASE_URL=""

# NextAuth
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Optional: outbound email for notifications (e.g. Resend, SMTP relay).
# Leave blank to disable email sending — in-app notifications still work.
EMAIL_FROM="Church Tasks <notifications@example.org>"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""

# Shared secret checked against the Authorization header on the automations cron endpoint
# (/api/cron/automations), which drives due-date-based workflow automation rules.
# Generate one with: openssl rand -base64 32
CRON_SECRET=""
