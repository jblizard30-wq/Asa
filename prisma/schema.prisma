generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  USER
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

// 'PERIODIC' — recur on schedule regardless of completion ("every Sunday").
// 'AFTER_COMPLETION' — the next occurrence is created only once the current one is
// marked done, dated relative to that completion.
enum RecurrenceMode {
  PERIODIC
  AFTER_COMPLETION
}

enum NotificationType {
  TASK_ASSIGNED
  COMMENT_ADDED
  PROJECT_INVITE
  REMINDER
  MENTIONED
  FORM_SUBMITTED
}

enum AutomationTriggerType {
  STATUS_CHANGED
  ASSIGNEE_CHANGED
  DUE_DATE_APPROACHING
}

enum AutomationActionType {
  SET_STATUS
  SET_ASSIGNEE
  MOVE_SECTION
  CREATE_TASK
}

enum AutomationAssigneeMode {
  SPECIFIC_USER
  SAME_AS_SOURCE
}

enum AutomationRunStatus {
  SUCCESS
  FAILED
  SKIPPED
}

enum CustomFieldType {
  TEXT
  NUMBER
  DATE
  SELECT
  CHECKBOX
}

enum IntakeFieldType {
  TEXT
  TEXTAREA
  EMAIL
  DATE
  SELECT
}

enum ActivityAction {
  STATUS_CHANGED
  ASSIGNEES_CHANGED
  PRIORITY_CHANGED
  DUE_DATE_CHANGED
  TITLE_CHANGED
  TAGS_CHANGED
  MOVED
  RESTORED
}

enum DigestFrequency {
  OFF
  DAILY
  WEEKLY
}

enum CalendarProvider {
  GOOGLE
  OUTLOOK
}

enum WebhookEvent {
  TASK_CREATED
  TASK_UPDATED
  TASK_COMPLETED
  TASK_DELETED
  COMMENT_ADDED
}

enum ReminderChannel {
  EMAIL
}

enum LiturgicalSeason {
  ADVENT
  CHRISTMAS
  LENT
  EASTER
  PENTECOST
  ORDINARY_TIME
}

enum RsvpStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model User {
  id                  String          @id @default(cuid())
  name                String
  email               String          @unique
  passwordHash        String
  role                Role            @default(USER)
  managerId           String?
  digestFrequency     DigestFrequency @default(OFF)
  lastDigestSentAt    DateTime?
  // Wall-clock hour (0-23) the daily/weekly digest should fire at, in the org's single
  // fixed America/Chicago timezone (this app is one church, not multi-timezone — see
  // src/lib/actions/taskRecurrences.ts's APP_TIMEZONE constant for the same convention).
  preferredDigestHour Int             @default(7)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  manager       User?  @relation("UserManager", fields: [managerId], references: [id], onDelete: SetNull)
  directReports User[] @relation("UserManager")

  projectsCreated Project[]       @relation("ProjectCreator")
  memberships     ProjectMember[]
  comments        Comment[]
  notifications   Notification[]  @relation("NotificationRecipient")
  triggeredNotifs Notification[]  @relation("NotificationActor")
  projectFolders  ProjectFolder[]

  managedTeams      Team[]       @relation("TeamManager")
  teamMemberships   TeamMember[]
  remindersSent     Reminder[]   @relation("ReminderSender")
  remindersReceived Reminder[]   @relation("ReminderRecipient")
  deletedTasks      Task[]       @relation("TaskDeletedBy")

  scheduledRemindersCreated  ScheduledReminder[] @relation("ScheduledReminderCreatedBy")
  scheduledRemindersReceived ScheduledReminder[] @relation("ScheduledReminderRecipient")

  createdAutomationRules       AutomationRule[] @relation("AutomationCreatedBy")
  automationActionAssignments  AutomationRule[] @relation("AutomationActionAssignee")
  automationNewTaskAssignments AutomationRule[] @relation("AutomationNewTaskAssignee")

  attachments                Attachment[]
  createdIntakeForms         IntakeForm[] @relation("IntakeFormCreatedBy")
  defaultAssigneeIntakeForms IntakeForm[] @relation("IntakeFormDefaultAssignee")

  createdWorkflows Workflow[] @relation("WorkflowCreatedBy")

  navPreferences NavPreference[]

  assignedTasks             Task[]                   @relation("TaskAssignees")
  timeEntries               TimeEntry[]
  loggedActivities          TaskActivity[]           @relation("TaskActivityActor")
  notificationPreferences   NotificationPreference[]
  savedFilters              SavedFilter[]
  createdGuestLinks         TaskGuestLink[]
  calendarConnections       CalendarConnection[]
  apiKeys                   ApiKey[]
  createdWebhooks           Webhook[]
  taskRecurrenceAssignments TaskRecurrence[]         @relation("TaskRecurrenceAssignees")
  createdServiceTemplates   ServiceTemplate[]
  volunteerAvailability     VolunteerAvailability[]
  availabilityExceptions    AvailabilityException[]

  submittedInventoryCounts StockCount[]   @relation("InventoryStockCountSubmittedBy")
  orderedRestockOrders     RestockOrder[] @relation("InventoryRestockOrderedBy")

  // RACI module (add-on — gated by ENABLED_MODULES, see src/lib/modules.ts).
  raciPersonLinks RaciPerson[] @relation("RaciPersonUser")

  @@index([managerId])
}

/// One row per redeemed HQ "log in as admin" support token (see src/lib/auth.ts).
/// The unique constraint on jti is what makes redemption single-use, not just
/// short-lived — a replayed token fails the insert instead of racing a check.
model SupportLoginToken {
  id     String   @id @default(cuid())
  jti    String   @unique
  usedAt DateTime @default(now())
}

/// Per-user customization of the sidebar navigation: display order and show/hide per item key.
model NavPreference {
  id      String  @id @default(cuid())
  userId  String
  itemKey String
  order   Int     @default(0)
  hidden  Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemKey])
  @@index([userId])
}

model Team {
  id        String   @id @default(cuid())
  name      String   @unique
  managerId String?
  manager   User?    @relation("TeamManager", fields: [managerId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members   TeamMember[]
  workflows Workflow[]
}

model TeamMember {
  id       String   @id @default(cuid())
  teamId   String
  userId   String
  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt DateTime @default(now())

  @@unique([teamId, userId])
  @@index([userId])
}

model Reminder {
  id          String   @id @default(cuid())
  taskId      String?
  task        Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  recipientId String
  recipient   User     @relation("ReminderRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  senderId    String
  sender      User     @relation("ReminderSender", fields: [senderId], references: [id])
  message     String
  createdAt   DateTime @default(now())

  @@index([recipientId])
  @@index([taskId])
}

/// A future-dated, opt-in reminder for a specific task — distinct from Reminder (which fires
/// immediately). A cron polls for deliverAt <= now() && sentAt == null, sends, and stamps
/// sentAt; the (deliverAt, sentAt) index keeps that poll cheap as the table grows. Vercel Cron
/// can duplicate an invocation, so the send path must atomically claim a row (update it to a
/// non-null sentAt conditioned on sentAt still being null) before delivering — never send first
/// and stamp after.
model ScheduledReminder {
  id          String          @id @default(cuid())
  taskId      String?
  task        Task?           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  recipientId String
  recipient   User            @relation("ScheduledReminderRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User            @relation("ScheduledReminderCreatedBy", fields: [createdById], references: [id])
  message     String
  channel     ReminderChannel @default(EMAIL)
  deliverAt   DateTime
  sentAt      DateTime?
  createdAt   DateTime        @default(now())

  @@index([deliverAt, sentAt])
  @@index([recipientId])
  @@index([taskId])
}

model Project {
  id              String    @id @default(cuid())
  name            String
  description     String?
  isPersonal      Boolean   @default(false)
  createdById     String
  createdBy       User      @relation("ProjectCreator", fields: [createdById], references: [id])
  workflowId      String?
  workflow        Workflow? @relation(fields: [workflowId], references: [id], onDelete: SetNull)
  settingsWriteup String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  members          ProjectMember[]
  sections         Section[]
  tasks            Task[]
  taskRecurrences  TaskRecurrence[]
  serviceTemplates ServiceTemplate[]
  extraHomedTasks  TaskProject[]
  automationRules  AutomationRule[]
  folderItems      ProjectFolderItem[]
  customFields     CustomField[]
  intakeForms      IntakeForm[]
  tags             Tag[]
  savedFilters     SavedFilter[]

  @@index([workflowId])
}

model ProjectFolder {
  id        String              @id @default(cuid())
  name      String
  order     Int                 @default(0)
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     ProjectFolderItem[]
  createdAt DateTime            @default(now())

  @@unique([userId, name])
}

model ProjectFolderItem {
  id        String        @id @default(cuid())
  folderId  String
  projectId String
  order     Int           @default(0)
  folder    ProjectFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@unique([folderId, projectId])
  @@index([projectId])
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt  DateTime @default(now())
  // Marks this member as the project's manager for the purposes of the project
  // exec-summary digest — distinct from the global MANAGER Role, which just grants
  // the capability; this flag says which specific project(s) they manage.
  isManager Boolean  @default(false)

  @@unique([projectId, userId])
}

model Section {
  id        String   @id @default(cuid())
  name      String
  projectId String
  order     Int      @default(0)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks     Task[]
  createdAt DateTime @default(now())

  automationTargets   AutomationRule[]
  intakeForms         IntakeForm[]
  taskRecurrences     TaskRecurrence[]
  serviceTemplateRuns ServiceTemplateRun[]
  extraHomedTasks     TaskProject[]
}


model Task {
  id          String     @id @default(cuid())
  title       String
  description String?
  url         String?
  projectId   String
  sectionId   String
  startDate   DateTime?
  dueDate     DateTime?
  priority    Priority   @default(MEDIUM)
  status      TaskStatus @default(TODO)
  order       Int        @default(0)

  parentTaskId String?

  // Set on every task materialized from a TaskRecurrence (both periodic and
  // after-completion occurrences) — never on a plain, non-recurring task.
  recurrenceId   String?
  occurrenceDate DateTime?

  deletedAt   DateTime?
  deletedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project            Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  section            Section                @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  extraProjects      TaskProject[]
  comments           Comment[]
  parentTask         Task?                  @relation("TaskSubtasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subtasks           Task[]                 @relation("TaskSubtasks")
  fieldValues        TaskCustomFieldValue[]
  reminders          Reminder[]
  scheduledReminders ScheduledReminder[]
  deletedBy          User?                  @relation("TaskDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  taskRecurrence     TaskRecurrence?        @relation(fields: [recurrenceId], references: [id], onDelete: SetNull)

  automationsAsSource AutomationRule[] @relation("AutomationSourceTask")
  automationsAsTarget AutomationRule[] @relation("AutomationTargetTask")

  attachments       Attachment[]
  intakeSubmissions IntakeSubmission[]
  tags              Tag[]              @relation("TaskTags")

  assignees     User[]           @relation("TaskAssignees")
  blockedBy     TaskDependency[] @relation("TaskBlockedTask")
  blocking      TaskDependency[] @relation("TaskBlockerTask")
  timeEntries   TimeEntry[]
  activities    TaskActivity[]
  guestLinks    TaskGuestLink[]
  guestComments GuestComment[]

  @@unique([recurrenceId, occurrenceDate])
  @@index([projectId])
  @@index([sectionId])
  @@index([parentTaskId])
  @@index([deletedAt])
  @@index([deletedById])
}

/// Join table enabling a task to belong to multiple projects simultaneously (multi-homing).
model TaskProject {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sectionId String?
  section   Section? @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@unique([taskId, projectId])
  @@index([taskId])
  @@index([projectId])
  @@index([sectionId])
}

/// The recipe, not the meals: one row per recurring task definition. A nightly job
/// materializes 'PERIODIC' occurrences on schedule (see RecurrenceMode); 'AFTER_COMPLETION'
/// occurrences are materialized inline, in the same request that marks the current one done.
/// The (recurrenceId, occurrenceDate) unique index on Task makes both paths idempotent —
/// Postgres treats every recurrenceId = NULL as distinct, so plain (non-recurring) tasks
/// never collide with each other under this constraint.
model TaskRecurrence {
  id          String   @id @default(cuid())
  title       String
  description String?
  projectId   String
  sectionId   String
  priority    Priority @default(MEDIUM)

  rrule     String
  timezone  String         @default("America/Chicago")
  mode      RecurrenceMode
  nextRunAt DateTime
  endsAt    DateTime?
  createdAt DateTime       @default(now())

  rotationEnabled Boolean @default(false)
  rotationSlots   Int     @default(1)

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  section   Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  assignees User[]  @relation("TaskRecurrenceAssignees")
  tasks     Task[]

  @@index([projectId])
  @@index([nextRunAt])
}

/// The recipe for a repeatable batch of tasks — e.g. "Sunday Service".
model ServiceTemplate {
  id          String   @id @default(cuid())
  name        String
  description String?
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])

  rrule     String?
  timezone  String    @default("America/Chicago")
  nextRunAt DateTime?
  endsAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items ServiceTemplateItem[]
  runs  ServiceTemplateRun[]

  @@index([projectId])
  @@index([nextRunAt])
}

/// One checklist line of a ServiceTemplate with liturgical season swap-in capability.
model ServiceTemplateItem {
  id                String                @id @default(cuid())
  serviceTemplateId String
  serviceTemplate   ServiceTemplate       @relation(fields: [serviceTemplateId], references: [id], onDelete: Cascade)
  parentId          String?
  parent            ServiceTemplateItem?  @relation("ServiceTemplateItemSubtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks          ServiceTemplateItem[] @relation("ServiceTemplateItemSubtasks")
  title             String
  description       String?
  order             Int                   @default(0)
  defaultPriority   Priority              @default(MEDIUM)
  dueOffsetDays     Int?
  season            LiturgicalSeason?

  @@index([serviceTemplateId])
  @@index([parentId])
}

/// The idempotency claim for one materialized occurrence of a ServiceTemplate.
model ServiceTemplateRun {
  id                String            @id @default(cuid())
  serviceTemplateId String
  serviceTemplate   ServiceTemplate   @relation(fields: [serviceTemplateId], references: [id], onDelete: Cascade)
  occurrenceDate    DateTime
  season            LiturgicalSeason?
  sectionId         String
  section           Section           @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  createdAt         DateTime          @default(now())

  @@unique([serviceTemplateId, occurrenceDate])
  @@index([serviceTemplateId])
}

/// A volunteer's weekly recurring availability pattern.
model VolunteerAvailability {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  dayOfWeek Int
  available Boolean @default(true)

  @@unique([userId, dayOfWeek])
  @@index([userId])
}

/// A one-off override of a specific calendar date for volunteer availability.
model AvailabilityException {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime
  available Boolean
  note      String?
  createdAt DateTime @default(now())

  @@unique([userId, date])
  @@index([userId])
}


model CustomField {
  id        String          @id @default(cuid())
  projectId String
  name      String
  type      CustomFieldType
  order     Int             @default(0)
  createdAt DateTime        @default(now())

  project Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  options CustomFieldOption[]
  values  TaskCustomFieldValue[]

  @@index([projectId])
}

model CustomFieldOption {
  id            String @id @default(cuid())
  customFieldId String
  label         String
  order         Int    @default(0)

  customField CustomField            @relation(fields: [customFieldId], references: [id], onDelete: Cascade)
  values      TaskCustomFieldValue[]

  @@index([customFieldId])
}

model TaskCustomFieldValue {
  id            String    @id @default(cuid())
  taskId        String
  customFieldId String
  textValue     String?
  numberValue   Float?
  dateValue     DateTime?
  boolValue     Boolean?
  optionId      String?
  updatedAt     DateTime  @updatedAt

  task        Task               @relation(fields: [taskId], references: [id], onDelete: Cascade)
  customField CustomField        @relation(fields: [customFieldId], references: [id], onDelete: Cascade)
  option      CustomFieldOption? @relation(fields: [optionId], references: [id], onDelete: SetNull)

  @@unique([taskId, customFieldId])
  @@index([customFieldId])
  @@index([optionId])
}

model Comment {
  id        String   @id @default(cuid())
  taskId    String
  userId    String
  body      String
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])
}

model Notification {
  id          String           @id @default(cuid())
  type        NotificationType
  recipientId String
  actorId     String?
  message     String
  link        String?
  read        Boolean          @default(false)
  createdAt   DateTime         @default(now())

  recipient User  @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor     User? @relation("NotificationActor", fields: [actorId], references: [id])

  @@index([recipientId])
}

model AutomationRule {
  id          String  @id @default(cuid())
  name        String
  enabled     Boolean @default(true)
  createdById String
  createdBy   User    @relation("AutomationCreatedBy", fields: [createdById], references: [id])

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  sourceTaskId String?
  sourceTask   Task?   @relation("AutomationSourceTask", fields: [sourceTaskId], references: [id], onDelete: Cascade)

  triggerType       AutomationTriggerType
  triggerStatus     TaskStatus?
  triggerDaysBefore Int?

  actionType AutomationActionType

  targetTaskId String?
  targetTask   Task?   @relation("AutomationTargetTask", fields: [targetTaskId], references: [id], onDelete: Cascade)

  actionStatus     TaskStatus?
  assigneeMode     AutomationAssigneeMode?
  actionAssigneeId String?
  actionAssignee   User?                   @relation("AutomationActionAssignee", fields: [actionAssigneeId], references: [id])

  targetSectionId String?
  targetSection   Section? @relation(fields: [targetSectionId], references: [id], onDelete: Cascade)

  newTaskTitle       String?
  newTaskDescription String?
  newTaskPriority    Priority?
  newTaskAssigneeId  String?
  newTaskAssignee    User?     @relation("AutomationNewTaskAssignee", fields: [newTaskAssigneeId], references: [id])

  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  runs      AutomationRun[]

  @@index([projectId])
  @@index([sourceTaskId])
  @@index([targetTaskId])
}


model AutomationRun {
  id        String              @id @default(cuid())
  ruleId    String
  rule      AutomationRule      @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  status    AutomationRunStatus
  detail    String?
  createdAt DateTime            @default(now())

  @@index([ruleId])
}

model Attachment {
  id           String   @id @default(cuid())
  taskId       String
  task         Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  fileName     String
  fileUrl      String
  filePathname String
  fileSize     Int
  mimeType     String
  createdAt    DateTime @default(now())

  @@index([taskId])
}

/// A public, no-login form (reachable at /forms/[slug]) whose submissions create a Task in a fixed project/section.
model IntakeForm {
  id                String   @id @default(cuid())
  name              String
  slug              String   @unique
  description       String?
  projectId         String
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sectionId         String
  section           Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  defaultAssigneeId String?
  defaultAssignee   User?    @relation("IntakeFormDefaultAssignee", fields: [defaultAssigneeId], references: [id], onDelete: SetNull)
  isActive          Boolean  @default(true)
  createdById       String
  createdBy         User     @relation("IntakeFormCreatedBy", fields: [createdById], references: [id])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  fields      IntakeFormField[]
  submissions IntakeSubmission[]

  @@index([projectId])
  @@index([sectionId])
}

model IntakeFormField {
  id       String          @id @default(cuid())
  formId   String
  form     IntakeForm      @relation(fields: [formId], references: [id], onDelete: Cascade)
  label    String
  type     IntakeFieldType
  required Boolean         @default(false)
  order    Int             @default(0)

  options IntakeFormFieldOption[]

  @@index([formId])
}

model IntakeFormFieldOption {
  id      String          @id @default(cuid())
  fieldId String
  field   IntakeFormField @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  label   String
  order   Int             @default(0)

  @@index([fieldId])
}

/// Kept even after the created Task is deleted, so admins retain a record of who submitted what.
model IntakeSubmission {
  id             String     @id @default(cuid())
  formId         String
  form           IntakeForm @relation(fields: [formId], references: [id], onDelete: Cascade)
  taskId         String?
  task           Task?      @relation(fields: [taskId], references: [id], onDelete: SetNull)
  submitterName  String
  submitterEmail String?
  answers        Json
  createdAt      DateTime   @default(now())

  @@index([formId])
  @@index([taskId])
}

/// An admin-built, optionally team-scoped blueprint of stages/tasks/subtasks. Can be flagged
/// as a reusable template (isTemplate) and applied to a Project to instantiate its Sections/Tasks.
model Workflow {
  id          String   @id @default(cuid())
  name        String
  description String?
  teamId      String?
  team        Team?    @relation(fields: [teamId], references: [id], onDelete: SetNull)
  isTemplate  Boolean  @default(false)
  createdById String
  createdBy   User     @relation("WorkflowCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  stages   WorkflowStage[]
  projects Project[]

  @@index([teamId])
}

model WorkflowStage {
  id         String   @id @default(cuid())
  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  name       String
  order      Int      @default(0)
  createdAt  DateTime @default(now())

  taskTemplates WorkflowTaskTemplate[]

  @@index([workflowId])
}

/// One level of subtask nesting via the self-relation, matching Task's own parentTaskId convention.
model WorkflowTaskTemplate {
  id              String                 @id @default(cuid())
  stageId         String
  stage           WorkflowStage          @relation(fields: [stageId], references: [id], onDelete: Cascade)
  parentId        String?
  parent          WorkflowTaskTemplate?  @relation("WorkflowTaskTemplateSubtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks        WorkflowTaskTemplate[] @relation("WorkflowTaskTemplateSubtasks")
  title           String
  description     String?
  order           Int                    @default(0)
  defaultPriority Priority               @default(MEDIUM)
  createdAt       DateTime               @default(now())

  @@index([stageId])
  @@index([parentId])
}

/// A project-scoped label with a color, freely assignable to any task in that project.
model Tag {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  color     String   @default("slate")
  order     Int      @default(0)
  createdAt DateTime @default(now())

  tasks Task[] @relation("TaskTags")

  @@unique([projectId, name])
  @@index([projectId])
}

model TimeEntry {
  id       String   @id @default(cuid())
  taskId   String
  task     Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  minutes  Int
  note     String?
  loggedAt DateTime @default(now())

  @@index([taskId])
  @@index([userId])
}

/// A directed edge in the task dependency graph: `blocked` cannot start until `blocker` is DONE.
/// Replaces the single-predecessor chain (Task.predecessorId) with a real many-to-many graph.
model TaskDependency {
  id        String   @id @default(cuid())
  blockedId String
  blockerId String
  blocked   Task     @relation("TaskBlockedTask", fields: [blockedId], references: [id], onDelete: Cascade)
  blocker   Task     @relation("TaskBlockerTask", fields: [blockerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockedId, blockerId])
  @@index([blockedId])
  @@index([blockerId])
}

model NotificationPreference {
  id           String           @id @default(cuid())
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         NotificationType
  emailEnabled Boolean          @default(true)

  @@unique([userId, type])
  @@index([userId])
}

/// A general "who changed what, when" record per task, distinct from AutomationRun (which only
/// logs automation executions). Written alongside existing mutations in lib/actions/tasks.ts etc.
model TaskActivity {
  id        String         @id @default(cuid())
  taskId    String
  task      Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     User?          @relation("TaskActivityActor", fields: [actorId], references: [id], onDelete: SetNull)
  action    ActivityAction
  detail    String
  createdAt DateTime       @default(now())

  @@index([taskId])
}

/// A named, persisted TaskFilters payload (see src/lib/taskFilters.ts) a user can re-apply later.
model SavedFilter {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  scope     String
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  filters   Json
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([projectId])
}

/// A shareable, token-based link granting no-login view/comment access to a single task —
/// same public-access shape as IntakeForm's slug, but scoped to one task instead of a form.
model TaskGuestLink {
  id          String    @id @default(cuid())
  taskId      String
  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  token       String    @unique
  canComment  Boolean   @default(true)
  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id])
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  requiresRsvp Boolean    @default(false)
  rsvpStatus   RsvpStatus @default(PENDING)
  rsvpAt       DateTime?

  guestComments GuestComment[]

  @@index([taskId])
}


/// A comment left by an unauthenticated guest through a TaskGuestLink — kept separate from
/// Comment (whose userId is a required real User) rather than making that field nullable.
model GuestComment {
  id          String        @id @default(cuid())
  guestLinkId String
  guestLink   TaskGuestLink @relation(fields: [guestLinkId], references: [id], onDelete: Cascade)
  taskId      String
  task        Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  guestName   String
  body        String
  createdAt   DateTime      @default(now())

  @@index([taskId])
  @@index([guestLinkId])
}

/// OAuth connection state for external calendar sync. Deliberately infrastructure-only: no cron
/// or code path calls syncEnabled connections yet (see lib/integrations/*), only Connect/Disconnect.
model CalendarConnection {
  id                 String           @id @default(cuid())
  userId             String
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider           CalendarProvider
  externalCalendarId String?
  accessToken        String?
  refreshToken       String?
  tokenExpiresAt     DateTime?
  syncEnabled        Boolean          @default(false)
  lastSyncedAt       DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([userId, provider])
  @@index([userId])
}

model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  keyHash    String    @unique
  keyPrefix  String
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model Webhook {
  id          String         @id @default(cuid())
  createdById String
  createdBy   User           @relation(fields: [createdById], references: [id], onDelete: Cascade)
  url         String
  secret      String
  events      WebhookEvent[]
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())

  @@index([createdById])
}

// ============================================================================
// Inventory module (add-on — gated by ENABLED_MODULES, see src/lib/modules.ts).
// Ported from the standalone Inventory-System app's Supabase schema. Two
// changes from that source schema: (1) profiles/auth folds into this app's
// own User/Role instead of a separate table, and (2) needed_qty and the
// on-hand-qty-follows-latest-stock-count behavior were Postgres generated
// columns / triggers there — both are plain application logic here instead
// (see src/lib/actions/inventory.ts), to match this schema's existing
// no-triggers convention.
// ============================================================================

/// A trackable inventory domain (e.g. "Weekly Consumables", "Liturgical & Worship Supplies").
model InventoryType {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  description  String?
  trackingMode String   @default("par_level")
  cadence      String   @default("weekly")
  icon         String?  @default("Package")
  createdAt    DateTime @default(now())

  items InventoryItem[]
}

model Building {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  rooms Room[]
}

model Room {
  id         String   @id @default(cuid())
  buildingId String
  building   Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  name       String
  createdAt  DateTime @default(now())

  items InventoryItem[]

  @@unique([buildingId, name])
}

model Vendor {
  id            String   @id @default(cuid())
  name          String
  contactPerson String?
  phone         String?
  email         String?
  url           String?
  notes         String?
  createdAt     DateTime @default(now())

  items         InventoryItem[]
  restockOrders RestockOrder[]
}

model InventoryItem {
  id               String         @id @default(cuid())
  inventoryTypeId  String?
  inventoryType    InventoryType? @relation(fields: [inventoryTypeId], references: [id], onDelete: SetNull)
  roomId           String
  room             Room           @relation(fields: [roomId], references: [id], onDelete: Cascade)
  name             String
  unit             String
  idealQty         Int
  onHandQty        Int            @default(0)
  reorderThreshold Int            @default(0)
  shelfLocation    String?
  sortOrder        Int            @default(0)
  vendorId         String?
  vendor           Vendor?        @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  notes            String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  stockCounts       StockCount[]
  restockOrderItems RestockOrderItem[]

  @@index([roomId])
  @@index([inventoryTypeId])
}

/// Append-only log — submitting a count also updates the parent item's onHandQty
/// (application logic, see src/lib/actions/inventory.ts), it does not overwrite history.
model StockCount {
  id            String   @id @default(cuid())
  itemId        String
  item          InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  qty           Int
  submittedById String?
  submittedBy   User?    @relation("InventoryStockCountSubmittedBy", fields: [submittedById], references: [id], onDelete: SetNull)
  submittedAt   DateTime @default(now())

  @@index([itemId, submittedAt(sort: Desc)])
}

model RestockOrder {
  id               String    @id @default(cuid())
  poNumber         String    @unique
  vendorId         String
  vendor           Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  status           String    @default("draft")
  orderDate        DateTime?
  expectedDelivery DateTime?
  totalCost        Decimal?  @db.Decimal(10, 2)
  orderedById      String?
  orderedBy        User?     @relation("InventoryRestockOrderedBy", fields: [orderedById], references: [id], onDelete: SetNull)
  notes            String?
  createdAt        DateTime  @default(now())

  items RestockOrderItem[]

  @@index([vendorId])
}

model RestockOrderItem {
  id               String       @id @default(cuid())
  orderId          String
  order            RestockOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  itemId           String
  item             InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  quantityOrdered  Int
  quantityReceived Int          @default(0)
  unitPrice        Decimal?     @db.Decimal(10, 2)
}

// ============================================================================
// RACI module (add-on — gated by ENABLED_MODULES, see src/lib/modules.ts).
// Ported from the standalone "Raci Repository" app, which is really an executive
// pastor toolbox: 18 Drizzle tables, of which only these four carry the RACI
// concept. The other 14 (initiatives, a 30-framework tool registry, an entity
// ledger, a strategy library, meeting packets) are a separate product.
//
// The shape is a matrix: a chart owns ordered steps (rows) and ordered people
// (columns), and RaciAssignment is the cell at each intersection. Asa-HQ-New's
// blueprint modelled this as a single flat row carrying one role, which cannot
// express "who is Accountable for step 3 of this process" — so this port follows
// the source app's shape rather than the blueprint's.
// ============================================================================

enum RaciRole {
  RESPONSIBLE
  ACCOUNTABLE
  CONSULTED
  INFORMED
}

model RaciChart {
  id           String    @id @default(cuid())
  processName  String
  trigger      String    @default("")
  owner        String    @default("")
  description  String    @default("")
  ministryArea String?
  reviewDate   DateTime?
  isTemplate   Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  archivedAt   DateTime?

  steps  RaciStep[]
  people RaciPerson[]

  @@index([archivedAt])
}

/// A row of the matrix.
model RaciStep {
  id        String    @id @default(cuid())
  chartId   String
  chart     RaciChart @relation(fields: [chartId], references: [id], onDelete: Cascade)
  stepName  String
  stepOrder Int       @default(0)
  createdAt DateTime  @default(now())

  assignments RaciAssignment[]

  @@index([chartId, stepOrder])
}

/// A column of the matrix. `userId` optionally links the free-text name to a real
/// CPCana user; the source app kept these as free text with an optional directory
/// link, and that stays optional here so a chart can name people with no login.
model RaciPerson {
  id          String    @id @default(cuid())
  chartId     String
  chart       RaciChart @relation(fields: [chartId], references: [id], onDelete: Cascade)
  name        String
  roleTitle   String    @default("")
  personOrder Int       @default(0)
  userId      String?
  user        User?     @relation("RaciPersonUser", fields: [userId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())

  assignments RaciAssignment[]

  @@index([chartId, personOrder])
  @@index([userId])
}

/// One matrix cell. Composite PK mirrors the source schema's (step_id, person_id).
/// `designations` is a list, not a single value, because one cell legitimately
/// carries more than one letter — a process owner is often both R and A.
model RaciAssignment {
  stepId       String
  step         RaciStep   @relation(fields: [stepId], references: [id], onDelete: Cascade)
  personId     String
  person       RaciPerson @relation(fields: [personId], references: [id], onDelete: Cascade)
  designations RaciRole[]
  updatedAt    DateTime   @updatedAt

  @@id([stepId, personId])
  @@index([personId])
}

// ============================================================================
// XP module (add-on — gated by ENABLED_MODULES, see src/lib/modules.ts).
// "XP" is Executive Pastor. Ported from Asa-HQ-New's prisma/schema/xp.prisma,
// re-keyed: every model there was `entityId String @id` against an `Entity`
// model that exists only in Asa-HQ-New's core schema, so each model gets its own
// cuid() id here. BoardPacket lives in XP rather than RACI — board decks are the
// executive pastor's deliverable, and keeping it here lets a customer enable
// either module without the other.
//
// FinancialSnapshot comes from the standalone "XP Skills" app's financial
// calculator; its drills, templates and SQL-reference pages are static content
// with no state and are deliberately not modelled, and its restock calculator is
// already covered by the Inventory module.
//
// Invariant 8 (§7.1) carried over from the blueprint: zero individual salary PII.
// The monetary models below deliberately carry NO userId foreign key, which is
// why this module adds no User back-relation at all.
// ============================================================================

model BudgetLine {
  id              String   @id @default(cuid())
  fiscalYear      Int
  category        String
  allocatedAmount Decimal  @db.Decimal(12, 2)
  spentAmount     Decimal  @default(0.00) @db.Decimal(12, 2)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([fiscalYear, category])
}

/// Why a line moved, captured per quarter. Threshold is the variance that
/// triggered the memo, so a reader can tell a $50 swing from a $50,000 one.
model VarianceMemo {
  id              String   @id @default(cuid())
  fiscalQuarter   String
  category        String?
  amountThreshold Decimal  @db.Decimal(12, 2)
  explanation     String
  mitigationPlan  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([fiscalQuarter])
}

model BoardPacket {
  id           String    @id @default(cuid())
  title        String
  meetingDate  DateTime
  packetUrl    String?
  summaryNotes String?
  status       String    @default("upcoming")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([meetingDate])
}

/// Inputs to the XP Skills financial calculator. The three health ratios
/// (program efficiency, months of reserve, personnel cost) are derived on read,
/// not stored, so a change to the formula never leaves stale numbers behind.
model FinancialSnapshot {
  id               String   @id @default(cuid())
  periodDate       DateTime
  unrestrictedCash Decimal  @db.Decimal(14, 2)
  annualRevenue    Decimal  @db.Decimal(14, 2)
  annualExpense    Decimal  @db.Decimal(14, 2)
  programExpense   Decimal  @db.Decimal(14, 2)
  personnelCost    Decimal  @db.Decimal(14, 2)
  varianceNote     String?
  createdAt        DateTime @default(now())

  @@index([periodDate])
}
